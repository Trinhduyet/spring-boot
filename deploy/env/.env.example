# Copy to deploy/.env on the Docker host; set real values through secret provisioning.
DB_URL=jdbc:sqlserver://sqlserver.example.internal:1433;databaseName=catalog;encrypt=true;trustServerCertificate=false
DB_USER=catalog_app
DB_PASSWORD=replace-through-secret-provisioning
JWT_ISSUER_URI=https://identity.example.com/
JWT_AUDIENCE=catalog-api
CORS_ALLOWED_ORIGINS=https://app.example.com
